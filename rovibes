local chosen=nil
for _,sec in IPA(candidates)do
if sec>0 and(not chosen or sec<chosen)then chosen=sec end
end
if not chosen then return false end

local total=MX(
chosen,
FL(TN(App.VoiceMuteTotalSec)or 0),
FL(TN(App.LocalPenaltyTotalSec)or 0),
FL(TN(App.LastVoicePenaltyDurationSec)or 0)
)
return stableStart(chosen,total,"bootstrap",true)
end

local function stableSyncUi()
