                    local width=math.max(item.label.Size.X.Offset,1)
                    local globalSpan=math.abs(math.cos(angle))*l.textWidth+math.abs(math.sin(angle))*44
                    local localSpan=math.abs(math.cos(angle))*width+math.abs(math.sin(angle))*44
                    item.gradient.Scale=globalSpan/math.max(localSpan,1)
                    item.gradient.Offset=V2((x*l.textWidth+l.textX+l.textWidth/2-item.baseX)/width,y)
                    item.gradient.Rotation=rotation
                    item.label.TextColor3=WHITE
                else
                    item.label.TextColor3=gradient and sampleStops(view.effectStops,u) or color
                end
            end
        end
    else
        for _,item in ipairs(view.glyphs or {}) do item.label.Visible=false;item.label.Rotation=0;item.label.TextTransparency=0;item.stroke.Transparency=0 end
        local v=config.textSpeed
        if animation=="Blink" then view.title.TextTransparency=(t*v)%1>=.55 and .85 or 0
        elseif animation=="Fade" then view.title.TextTransparency=pulse01(t*v*3)*.75
        elseif animation=="Slide" then view.title.Position=UDim2.fromOffset(l.textX+math.sin(t*v*3)*(canUseAnyTagName() and (config.motionAmount or 2) or math.min(config.motionAmount or 2,3)),l.titleY)
        elseif animation=="Typewriter" or animation=="TypingErase" then
            local n=view.characterCount;local rate=10*v;local duration=n/rate
            local phase=t%(duration+1.2+(animation=="TypingErase" and duration or 0)+.5)
            if phase<duration then view.title.MaxVisibleGraphemes=math.floor(phase*rate)
            elseif phase<duration+1.2 then view.title.MaxVisibleGraphemes=-1
            elseif animation=="TypingErase" and phase<duration*2+1.2 then view.title.MaxVisibleGraphemes=n-math.floor((phase-duration-1.2)*rate)
            else view.title.MaxVisibleGraphemes=0 end
        elseif animation=="BounceGroup" then view.title.Position=UDim2.fromOffset(l.textX,l.titleY-(canUseAnyTagName() and (config.motionAmount or 2) or math.clamp(config.motionAmount or 2,0,4))*math.abs(math.sin(t*v*3)))
        elseif glyphAnimations[animation] then
            local dx,dy,tilt,alpha=characterMotion(animation,t,1,1)
            -- No fallback de escrita complexa, a rotação do título longo fica zerada para preservar o espaço da subtag.
            view.title.Position=UDim2.fromOffset(l.textX+dx,l.titleY+dy);view.title.Rotation=0;view.title.TextTransparency=alpha
        end
    end
    if view.titleStroke then view.titleStroke.Transparency=view.title.TextTransparency end
end




