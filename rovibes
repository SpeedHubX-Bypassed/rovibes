    ColorPicker.cursor.Position=UDim2.fromOffset(96+math.cos(ColorPicker.h*math.pi*2)*84*ColorPicker.s,
        96+math.sin(ColorPicker.h*math.pi*2)*84*ColorPicker.s)
    ColorPicker.valueCursor.Position=U2(.5,0,1-ColorPicker.v,0)
    ColorPicker.valueGradient.Color=ColorSequence.new(Color3.fromHSV(ColorPicker.h,ColorPicker.s,1),RGB(0,0,0))
end
function ColorPicker.read(color)
    local maximum=math.max(color.R,color.G,color.B)
    local minimum=math.min(color.R,color.G,color.B)
    local delta=maximum-minimum
    local h=0
    if delta>0 then
        if maximum==color.R then h=((color.G-color.B)/delta)%6
        elseif maximum==color.G then h=(color.B-color.R)/delta+2
        else h=(color.R-color.G)/delta+4 end
        h=h/6
    end
    ColorPicker.h=h;ColorPicker.s=maximum>0 and delta/maximum or 0;ColorPicker.v=maximum
    ColorPicker.sync()
end
function ColorPicker.apply()
    if not ColorPicker.key then return end
    local color=Color3.fromHSV(ColorPicker.h,ColorPicker.s,ColorPicker.v)
    local p=palette()
    config.customColors={name="Personalizada",primary=p.primary,secondary=p.secondary,subtitle=p.subtitle,stroke=p.stroke}
    config.customColors[ColorPicker.key]=color
