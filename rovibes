local function measureTagText(text,size,name)
    text=tostring(text or "")
    size=math.clamp(tonumber(size) or 24,1,100)
    local record=fontRecord(name)
    local useFace=record and record.isExtended and record.face and not record.assignmentFallback
    local key=fontMeasureKey(record,text,size)
    local entry=fontMeasureCache[key]
    if not entry then
        local ok,result=pcall(function()
            return TextService:GetTextSize(text,size,record and record.value or FB,V2(4096,128))
        end)
        local width
        if ok then pcall(function() width=result.X end) end
        local baseConfirmed=type(width)=="number" and width==width and width>=0 and width<=8192
        if not baseConfirmed then
            local countOk,count=pcall(utf8.len,text)
            width=(countOk and count or #text)*size*.65
        end
        entry={text=text,size=size,record=record,width=width,
            resolved=not useFace,baseConfirmed=baseConfirmed,
            measurement=baseConfirmed and "ENUM_GET_TEXT_SIZE" or "ESTIMATED_WIDTH"}
