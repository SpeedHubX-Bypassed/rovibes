local function stableStart(seconds,totalSec,source,forceNew)
local st=stableState()
local now=stableTick()
local sec=MX(0,CE(TN(seconds)or 0))
if sec<=0 then return false end

local candidate=now+sec
local current=TN(st.EndTick)or 0
local active=current>now
local changed=false

if forceNew==true or not active then
st.Generation=(TN(st.Generation)or 0)+1
st.EndTick=candidate
st.StartedTick=now
st.TotalSec=MX(sec,FL(TN(totalSec)or 0))
st.Source=TS(source or"new")
st.Completed=false
st.HadPenalty=true
st.LastRenderedRemaining=sec
App.VoiceMuteEndNoticeShown=false
changed=true
elseif candidate<current-0.25 then
-- Mesma punicao: aceita somente uma correcao que DIMINUA o prazo.
st.EndTick=candidate
if(TN(st.TotalSec)or 0)<=0 then
st.TotalSec=MX(sec,FL(TN(totalSec)or 0))
end
st.Source=TS(source or"shorten")
changed=true
else
-- Resposta atrasada que tentaria empurrar o relogio para frente.
st.LastBackendCandidate=sec
end

local remaining=stableRemaining()
if remaining>0 then
stableWriteFields(remaining)
if changed then stableScheduleExpiry()end
end
return changed
end

local function stableBootstrap()
local st=stableState()
local now=stableTick()
local endTick=TN(st.EndTick)or 0

-- IMPORTANTISSIMO:
-- se nossa propria ancora ja venceu, finalize. Nao rebootstrap de
-- VoiceMuteRemainingSec=1/UntilMs espelhados pelo proprio timer.
if endTick>0 and endTick<=now then
stableFinish("bootstrap_expired")
return false
end

if endTick>now then return true end

if not(App.VoiceMuted==true or(TN(App.VoiceMuteRemainingSec)or 0)>0)then
return false
end

local candidates={}
local direct=MX(0,FL(TN(App.VoiceMuteRemainingSec)or 0))
if direct>0 then candidates[#candidates+1]=direct end

local nowMs=stableNowMs()
for _,value in IPA({
App.VoiceMuteUntilMs,
App.LocalPenaltyUntilMs,
App.ClientDerivedMuteUntilMs,
App.__3FV60AuthoritativeUntilMs
})do
local v=TN(value)or 0
