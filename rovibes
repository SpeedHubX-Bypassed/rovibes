function LB.cleanGameRole(v)
	local s=tostring(v or""):gsub("^%s+",""):gsub("%s+$","")
	if s==""or s=="false"or s=="0"then return nil end
	return s
end
function LB.defaultGameRole(v)
	local s=LB.normalize(v):gsub("[%s_%-%./]+","")
	return GAME_ROLE_DEFAULT[s]==true
end
function LB.specialGameRole(v)
	local s=LB.normalize(v)
	if s==""then return false end
	for _,w in ipairs(GAME_ROLE_WORDS)do if string.find(s,w,1,true)then return true end end
	return false
end
function LB.cropGameRole(v)
	local s=LB.cleanGameRole(v)
	if not s then return nil end
	if #s>16 then s=string.sub(s,1,15).."…"end
	return string.upper(s)
end
function LB.colorFromValue(v)
	if typeof(v)=="Color3"then return v end
	if type(v)=="string"then
		local hex=v:match("#?(%x%x%x%x%x%x)")
		if hex then
			local r=tonumber(hex:sub(1,2),16);local g=tonumber(hex:sub(3,4),16);local b=tonumber(hex:sub(5,6),16)
			if r and g and b then return Color3.fromRGB(r,g,b)end
		end
		local r,g,b=v:match("(%d+)%s*,%s*(%d+)%s*,%s*(%d+)")
		if r then return Color3.fromRGB(math.clamp(tonumber(r)or 0,0,255),math.clamp(tonumber(g)or 0,0,255),math.clamp(tonumber(b)or 0,0,255))end
	end
	return nil
end
function LB.labelPrimaryColor(label)
