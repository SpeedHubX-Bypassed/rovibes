local Core = {}
function Core.finite(n)
    return type(n)=="number" and n==n and math.abs(n)<math.huge
end
function Core.message(s)
    if type(s)~="string" then return nil end
    local ok,stop=pcall(utf8.offset,s,181)
    if not ok then return "Mensagem indisponível." end
    return stop and string.sub(s,1,stop-1) or s
end
function Core.blend(age,duration,fade)
    local length=math.min(math.max(0,fade),duration)
    local a=length>0 and math.clamp(age/length,0,1) or 1
    -- Velocidade constante, sem desacelerar e parar a cada pose.
    return a
end
function Core.opacities(current,previous,blend)
    if current==previous then return 1,0 end
    -- Base opaca + entrada da próxima pose: a máscara não revela o jogo no meio da troca.
    return math.clamp(blend,0,1),1
end
-- Âncoras do chapéu nos PNGs existentes, já incluindo sceneOffsetY.
-- [largura da aba, altura da aba], como fração do quadro 1254x1254.
local cameraAnchors={
    [14]={0.285,0.400},[15]={0.400,0.400},[16]={0.500,0.400},
    [17]={0.600,0.350},[18]={0.720,0.310},[19]={0.800,0.300},[20]={0.800,0.300},
}
function Core.camera(index,previous,a)
    local current,old=cameraAnchors[index],cameraAnchors[previous]
    if not current or not old or index==previous then return 1,0,0,1,0,0 end
    a=math.clamp(a,0,1)
    local width=old[1]+(current[1]-old[1])*a
    local y=old[2]+(current[2]-old[2])*a
    local scaleA,scaleB=width/current[1],width/old[1]
    return scaleA,0.5*(1-scaleA),y-current[2]*scaleA,
        scaleB,0.5*(1-scaleB),y-old[2]*scaleB
end
function Core.breath(elapsed)
    -- Começa neutro, com período de 3,2 s e menos de um pixel de deslocamento.
    local wave=1-math.cos(math.max(0,elapsed)*math.pi*2/3.2)
    return 1+0.0015*wave,-0.30*wave
end
function Core.plan(ready,cfg)
    local plan={intro={},loop={},introTime=0,loopTime=0}
    local function append(list,index,duration)
        table.insert(list,{index=index,duration=duration})
    end
    for i=1,30 do
        if ready[i] then
            local duration=i<=20 and cfg.INTRO_SECONDS_PER_FRAME or cfg.REVEAL_SECONDS_PER_FRAME
            append(plan.intro,i,duration)
            plan.introTime+=duration
        end
    end
    -- Continua a partir do 30 voltando ao 29, em vez de saltar do 30 ao 21.
    -- O raio 27 aparece na primeira passagem; o loop calmo mantém a escolha do V6.
    for _,i in ipairs({29,28,26,25,24,23,22,21,22,23,24,25,26,28,29,30}) do
        if ready[i] then append(plan.loop,i,cfg.MASK_SECONDS_PER_FRAME);plan.loopTime+=cfg.MASK_SECONDS_PER_FRAME end
    end
    if #plan.loop==0 and #plan.intro>0 then
        append(plan.loop,plan.intro[#plan.intro].index,cfg.MASK_SECONDS_PER_FRAME)
        plan.loopTime=cfg.MASK_SECONDS_PER_FRAME
    end
    function plan:Sample(elapsed)
        if #self.intro==0 then return nil end
        elapsed=math.max(0,elapsed)
        local inIntro=elapsed<self.introTime
        local list=inIntro and self.intro or self.loop
        local age=inIntro and elapsed or (elapsed-self.introTime)%self.loopTime
        local previous=inIntro and self.intro[1].index or self.intro[#self.intro].index
        if not inIntro and elapsed>=self.introTime+self.loopTime then previous=self.loop[#self.loop].index end
        for position,item in ipairs(list) do
            if age<item.duration or position==#list then
                return item.index,previous,age,item.duration,inIntro
            end
            age-=item.duration
            previous=item.index
        end
    end
    return plan
end

