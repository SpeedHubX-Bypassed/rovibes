local HttpService = game:GetService("HttpService")
local PRESET_FILE = "3F_UI_preset.json"
local function keyFromName(n)
    if not n then return nil end
    local ok, e = pcall(function() return Enum.KeyCode[n] end); if ok and e then return e end
    local ok2, e2 = pcall(function() return Enum.UserInputType[n] end); if ok2 and e2 then return e2 end
    return nil
end
local function SavePreset()
    local d = {
        aimbotFOV = State.aimbotFOV, aimSpeed = State.aimSpeed, aimbotHitbox = State.aimbotHitbox,
        aimHoldEnabled = State.aimHoldEnabled, teamCheckEnabled = State.teamCheckEnabled,
        crosshairRadius = State.crosshairRadius, lockSightRange = State.lockSightRange, espMode = State.espMode,
        aimHotkey = State.aimHotkey and State.aimHotkey.Name, aimHoldKey = State.aimHoldKey and State.aimHoldKey.Name,
        panelHotkey = State.panelHotkey and State.panelHotkey.Name,
    }
    local ok = pcall(function() writefile(PRESET_FILE, HttpService:JSONEncode(d)) end)
    Notify("Preset", ok and "Saved" or "No file support")
end
local function LoadPreset()
    local ok, raw = pcall(function() return readfile(PRESET_FILE) end)
    if not ok or not raw then return end
    local ok2, d = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok2 or type(d) ~= "table" then return end
    for k, v in pairs(d) do
        if State[k] ~= nil and k ~= "aimHotkey" and k ~= "aimHoldKey" and k ~= "panelHotkey" then State[k] = v end
    end
    State.aimHotkey = keyFromName(d.aimHotkey) or State.aimHotkey
    State.aimHoldKey = keyFromName(d.aimHoldKey) or State.aimHoldKey
    State.panelHotkey = keyFromName(d.panelHotkey) or State.panelHotkey
end
