function State.triggerMastery(source)
    if not State.alive then return false,"3F TAG STUDIO encerrado." end
    local isVIP,months=State.refreshVIPProfile()
    if not isVIP then return false,"Maestria é um sistema exclusivo para usuários VIP." end
    local platform=normalizePresencePlatform(resolvedPlatform())
    if platform~="PC" and platform~="MOBILE" then return false,"A maestria funciona em PC e celular." end
    if not State.animation then return false,"Ligue a animação para exibir a maestria." end
    if not RUNTIME_RENDER_MODE and not (State.testing and State.world and State.world.view and State.world.gui.Parent) then
        return false,"Ative a prévia no personagem para exibir a maestria."
    end
    local owner=State.subjectIsOwner()
    local t=State.elapsed or 0
    if not owner and State.masteryNext and t<State.masteryNext then
        return false,"Maestria VIP em recarga. Aguarde "..string.format("%.1f",State.masteryNext-t).."s."
    end
    local tier=owner and 3 or months
    State.playMasteryVisual(tier,source or "SELF")
    State.masteryNext=owner and nil or t+2
    State.emitMasteryRequest(tier)
    return true,(owner and "Maestria Owner · Level III · sem recarga." or ("Maestria VIP · "..State.masteryLabel(months).." · recarga 2s."))
