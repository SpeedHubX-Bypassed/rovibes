    if type(raw)~="table" then return false end
    local function put(key,value) if value~=nil then config[key]=value end end
    local importedStructuredTitle=cleanTitle(raw.title)
    if importedStructuredTitle~=nil and importedStructuredTitle~="" then put("title",importedStructuredTitle) end
    if canUseAnyTagName() then put("subtitle",cleanTitle(raw.subtitle) or config.subtitle); if raw.subtitleEnabled~=nil then config.subtitleEnabled=raw.subtitleEnabled~=false end end
    if fontLookup[tostring(raw.font or"")] then config.font=tostring(raw.font) end
    if fontLookup[tostring(raw.subtitleFont or"")] then config.subtitleFont=tostring(raw.subtitleFont) end
    if type(State.TagEffectOptions)=="table" and table.find(State.TagEffectOptions,tostring(raw.effect or"")) then config.effect=tostring(raw.effect) end
    if type(State.TagTextAnimationOptions)=="table" and table.find(State.TagTextAnimationOptions,tostring(raw.textAnimation or"")) then config.textAnimation=tostring(raw.textAnimation) end
    for _,key in ipairs({"size","subtitleSize","height","speed","intensity","amplitude","stroke","width","height","offset","tagOffsetX","tagOffsetY","maxDistance","textSpeed","motionAmount","platformIconScale"}) do
        local n=tonumber(raw[key]); if n and n==n and math.abs(n)~=math.huge then config[key]=n end
    end
    local platform=tostring(raw.platform or"AUTO"):upper(); if table.find({"AUTO","PC","MOBILE"},platform) then config.platform=platform end
    local iconVariant=tostring(raw.platformIconVariant or config.platformIconVariant or "DEFAULT"):upper(); if iconVariant=="BLACK" or iconVariant=="WHITE" then iconVariant="DEFAULT" end; if iconVariant=="DEFAULT" or iconVariant=="HALLOWEEN" then config.platformIconVariant=iconVariant end
    config.platformTier=raw.platformTier or 1
    config.animationQuality=tostring(raw.animationQuality or "AUTO")
    -- Mantém a identidade VIP e aplica o tier somente após validar esta conta.
    config.iconStyle="VIP"
    local p={name="Importada",primary=parseHex(raw.primary) or palette().primary,secondary=parseHex(raw.secondary) or palette().secondary,
        subtitle=parseHex(raw.subtitleColor) or palette().subtitle,stroke=parseHex(raw.strokeColor) or palette().stroke}
    config.customColors=p
    -- Campo legado aceito no arquivo, mas a primária decide a cor do ícone.
    config.iconColor=nil
    enforceRules()
    return true
end

-- R5 buyer draft: SALVAR TAG is local persistence, separate from sending for owner approval.
-- File persistence is used when the executor supports readfile/writefile; ENV memory is the fallback.
local DRAFT_FILE="3F_TAG_LAB_R5_DRAFT_"..tostring(LP.UserId)..".json"
local DRAFT_ENV_KEY="__3F_TAG_LAB_R5_DRAFT_"..tostring(LP.UserId)
local function saveLocalDraft()
    local payload=exportStructuredConfig()
    ENV[DRAFT_ENV_KEY]=payload
    local writeFn=ENV.writefile or writefile
    if type(writeFn)=="function" then
        pcall(function() writeFn(DRAFT_FILE,HttpService:JSONEncode(payload)) end)
    end
    return true,payload
end
local function loadLocalDraft()
    local cached=ENV[DRAFT_ENV_KEY]
    if type(cached)=="table" then return cached,"memory" end
    local readFn=ENV.readfile or readfile
    local isFileFn=ENV.isfile or isfile
    if type(readFn)~="function" then return nil end
    if type(isFileFn)=="function" then
        local okExists,exists=pcall(isFileFn,DRAFT_FILE)
        if not okExists or not exists then return nil end
    end
    local okRead,text=pcall(readFn,DRAFT_FILE)
    if not okRead or type(text)~="string" or text=="" then return nil end
    local okJson,decoded=pcall(function() return HttpService:JSONDecode(text) end)
    if not okJson or type(decoded)~="table" then return nil end
    ENV[DRAFT_ENV_KEY]=decoded
    return decoded,"file"
end

local normalizePresencePlatform
State.PLATFORM_ICON_SCALE_MIN=.75
State.PLATFORM_ICON_SCALE_MAX=4
State.platformIconScaleForTitle=function(_titleSize)
    -- Escala visual real usada pelo renderer; layout reserva exatamente o mesmo espaço.
    return 1.85
end

local function layout(textWidth, subtitleWidth, width, titleSize)
    local size=titleSize or config.size
    local iconScale=State.platformIconScaleForTitle(size)
    local iconWidth,iconHeight=24*iconScale,26*iconScale
    local column=math.max(12,textWidth+4)
    local platform=normalizePresencePlatform(resolvedPlatform())
    local gap=platform=="MOBILE" and 8 or 10
    local comboWidth=iconWidth+gap+column
    local iconX=(width-comboWidth)/2
    local textX=iconX+iconWidth+gap
    local center=textX+column/2
    local subWidth=subtitleWidth+4
    local subCenter=center+math.max(0,(column-subWidth)/2)
    local titleY
    if RUNTIME_LEGACY_R5_COMPAT then
        local legacyIconHeight=26*(size/24)
        titleY=math.max(26,size/2+config.stroke+4,legacyIconHeight/2+4)
    else
        titleY=math.max(26,size/2+config.stroke+4)
    end
    local subtitleY=titleY+size/2+config.stroke+3+config.subtitleSize/2
    -- O slot é centralizado geometricamente no mesmo eixo vertical do título.
    return {iconX=iconX,iconY=titleY-iconHeight/2,iconWidth=iconWidth,iconHeight=iconHeight,
        iconScale=iconScale,textX=textX,textWidth=column,titleY=titleY,
        subtitleX=subCenter-subWidth/2,subtitleWidth=subWidth,subtitleY=subtitleY,gap=gap,
        height=math.max(config.height,math.ceil(subtitleY+config.subtitleSize/2+5))}
end


local function tagMetrics()
    enforceRules()
    local font,subFont=config.font,config.subtitleFont
    local actualSize=config.size
    local function logicalMeasure(text,size,chosenFont)
        local nativeSize=math.min(size,100)
        return measureTagText(text,nativeSize,chosenFont)*size/nativeSize
    end
    local textWidth=logicalMeasure(config.title,actualSize,font)
    local subWidth=logicalMeasure(config.subtitle,config.subtitleSize,subFont)
    local width
    if RUNTIME_LEGACY_R5_COMPAT then
        local legacyScale=actualSize/24
        width=math.max(config.width,textWidth+2*(24*legacyScale+8)+12,subWidth*2+32)
    else
        width=math.max(config.width,textWidth+2*(24*State.PLATFORM_ICON_SCALE_MAX+8)+12,subWidth*2+32)
    end
    local l=layout(textWidth,subWidth,width,actualSize)
    l.width=width
    return actualSize,l
end
