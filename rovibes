local function queueFontMeasure(key,entry)
    if entry.queued or entry.resolved or entry.failed then return end
    if not task or type(task.spawn)~="function" then entry.failed="NO_ASYNC_RUNTIME";return end
    if fontQueueTail-fontQueueHead+1>=FONT_QUEUE_LIMIT then return end
    entry.queued=true
    fontQueueTail+=1;fontMeasureQueue[fontQueueTail]={key=key,entry=entry}
    startFontMeasureWorkers()
end
startFontMeasureWorkers=function()
    if not State.alive then return end
    while fontMeasureWorkers<2 and fontQueueHead<=fontQueueTail do
        fontMeasureWorkers+=1
        task.spawn(function()
            while State.alive and fontQueueHead<=fontQueueTail do
                local job=fontMeasureQueue[fontQueueHead]
                fontMeasureQueue[fontQueueHead]=nil;fontQueueHead+=1
                local key,entry=job.key,job.entry
                if fontMeasureCache[key]==entry then
                    local completed=false
                    if type(task.delay)=="function" then
                        task.delay(FONT_MEASURE_TIMEOUT,function()
                            if completed or not State.alive or fontMeasureCache[key]~=entry then return end
                            entry.failed="FONT_MEASUREMENT_TIMEOUT"
                            entry.queued=false
                            State.fontMetricsDirty=true
                            -- O worker continua ocupado até o retorno real, preservando o limite de dois.
                        end)
                    end
                    local params
                    local success,bounds=pcall(function()
                        params=Instance.new("GetTextBoundsParams")
                        params.Text=entry.text;params.Font=entry.record.face
                        params.Size=entry.size;params.Width=4096
                        return TextService:GetTextBoundsAsync(params)
                    end)
                    completed=true
                    if params then pcall(function() params:Destroy() end) end
                    if State.alive and fontMeasureCache[key]==entry then
                        entry.queued=false
                        local valid,width=pcall(function() return bounds.X end)
                        if success and valid and type(width)=="number" and width==width and width>=0 and width<=8192 then
                            local changed=math.abs(entry.width-width)>.05
                            entry.width=width;entry.resolved=true;entry.failed=nil;entry.measurement="FONT_FACE_GET_TEXT_BOUNDS_ASYNC"
                            State.fontMetricsDirty=true -- A conclusão também libera o modo por letra quando a largura não muda.
                        else
                            entry.failed="FONT_MEASUREMENT_UNAVAILABLE"
                            State.fontMetricsDirty=true
                        end
                    end
                end
            end
            fontMeasureWorkers-=1
