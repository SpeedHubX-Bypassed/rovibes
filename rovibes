local function luxyCaptureAnchor(player,data)
if not(player and data and data.Billboard)then return nil end
local char=player.Character
local root=char and char:FindFirstChild("HumanoidRootPart")
local head=char and char:FindFirstChild("Head")
if not(root and head)then return nil end

for _,child in IPA(root:GetChildren())do
if child:IsA("Attachment")and child.Name==LUXY_ANCHOR_NAME then
safeDestroy(child)
end
end

local captured=MX(0,head.Position.Y-root.Position.Y)
local attachment=I0("Attachment")
attachment.Name=LUXY_ANCHOR_NAME
attachment.Position=V3(0,captured,0)
attachment.Parent=root

data.LuxyAnchorR3=attachment
