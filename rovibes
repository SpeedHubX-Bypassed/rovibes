end
if data.SubtitleStroke then
data.SubtitleStroke.Color=LUXY_STROKE
data.SubtitleStroke.Thickness=0.8
data.SubtitleStroke.Transparency=0
end
local bb=data.Billboard
if bb and bb.Parent then
bb.Size=U2O(LUXY_WIDTH,LUXY_HEIGHT)
bb.StudsOffsetWorldSpace=V3(0,LUXY_OFFSET_Y,0)
bb.MaxDistance=LUXY_MAX_DISTANCE
end
end

