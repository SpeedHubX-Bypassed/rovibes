function ColorPicker.pointer(input)
    local target=ColorPicker.drag=="wheel" and ColorPicker.wheel or ColorPicker.valueBar
    if not target then return end
    local point=input.Position
    local origin,size=target.AbsolutePosition,target.AbsoluteSize
    if not point or not origin or not size or size.X<=0 or size.Y<=0 then return end
    if ColorPicker.drag=="wheel" then
        ColorPicker.wheelAt((point.X-origin.X)*192/size.X,(point.Y-origin.Y)*192/size.Y)
    else ColorPicker.valueAt((point.Y-origin.Y)*180/size.Y) end
