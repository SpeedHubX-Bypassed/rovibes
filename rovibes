-- X/Z e rotação vão para a HUB; a altura original é preservada e o buraco negro cresce 8% ao redor do próprio pivô.
for _,spec in ipairs(ASSET_GEOMETRY)do
 local values=spec.cframe
 if type(values)=="table"and #values>=12 then
  local moved=BOARD_RELOCATION*CFrame.new(table.unpack(values))
  local relative=ASSET_CFRAME:ToObjectSpace(moved)
  moved=ASSET_CFRAME*CFrame.new(relative.Position*BLACK_HOLE_VISUAL_SCALE)*relative.Rotation
  spec.cframe={moved:GetComponents()}
 end
 local size=spec.size
 if type(size)=="table"and #size>=3 then
  spec.size={size[1]*BLACK_HOLE_VISUAL_SCALE,size[2]*BLACK_HOLE_VISUAL_SCALE,size[3]*BLACK_HOLE_VISUAL_SCALE}
 end
end

