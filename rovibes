local function vectorOK(v) return v ~= nil and finite(v.X) and finite(v.Y) and finite(v.Z) end
local function cframeOK(cf)
    if not cf then return false end
    for _, n in ipairs({ cf:GetComponents() }) do if not finite(n) then return false end end
    return true
end
local function bound(value, limit)
    local s = tostring(value)
    if #s <= limit then return s end
    local ok, at = pcall(utf8.offset, s, 0, limit + 1)
    return s:sub(1, ok and at and at - 1 or limit) .. "..."
end
local function path(obj)
    local ok, result = pcall(function() return obj:GetFullName() end)
    return bound(ok and result or "objeto indisponivel", 240)
end
function Core.new(deps)
    local self = {
        D = deps, Mode = "Off", Alive = true, Connections = {}, Patches = {}, PatchCount = 0,
        States = {}, Shields = {}, Counters = { actions = 0, observed = 0, residual = 0, errors = 0, returns = 0, returnsObserved = 0,
            preGuards = 0, postGuards = 0, dampings = 0, upReturns = 0 },
        LogTimes = {}, PhaseErrors = {}, NextScan = 0, NextSummary = 0, LastRecovery = -math.huge,
        SuspendedUntil = 0, Parts = {}, Nodes = {}, Status = "Escolha uma protecao",
        FarReturnEnabled = true, LastFarReturn = -math.huge,
        ImpactUntil = 0, LastFlingHitAt = -math.huge, LastPositionRecovery = -math.huge, NextShieldScan = 0,
    }
    local V0 = Vector3.new(0, 0, 0)
    local HS = Enum.HumanoidStateType
    function self:Log(level, code, message, interval)
        local now = deps.Clock()
        if interval and now - (self.LogTimes[code] or -math.huge) < interval then return end
        self.LogTimes[code] = now
        deps.Report(level, code, bound(message, 800), self.Mode)
    end
    function self:Failure(code, message)
        self.Counters.errors += 1
        self:Log("WARN", code, message, 3)
    end
    function self:StatusChanged(text)
        if self.Status == text then return end
        self.Status = text
        if deps.OnStatus then deps.OnStatus(self.Mode, text) end
    end
    function self:PauseConflicts()
        if self.Mode == "Off" or not deps.PauseConflicts then return end
        local ok, result = pcall(deps.PauseConflicts)
        if not ok then self:Failure("CONFLICT_PAUSE", result); return end
        self.ConflictInfo = result
        if type(result) == "table" and result.changed then
            self:Log("WARN", "CONFLICT_DISABLED", "Modos ofensivos do proprio 3F desligados: WalkFling=" .. tostring(result.walk) .. " | ClickFling=" .. tostring(result.click) .. " | legado=" .. tostring(result.legacy == true) .. ". Nao serao reativados automaticamente.", 1)
        end
    end
    function self:ClearReturnTracking()
        self.MotionSample = nil; self.Flight = nil; self.ReturnPending = nil
        self.LastFarReturn = -math.huge
    end
    function self:ClearImpact()
        self.ImpactUntil = 0; self.LastFlingHitAt = -math.huge
        self.LastPositionRecovery = -math.huge; self.NextShieldScan = 0
    end
    function self:SetFarReturn(enabled)
        if not self.Alive or type(enabled) ~= "boolean" then return false end
        self.FarReturnEnabled = enabled; self:ClearReturnTracking(); self.StableSince = nil
        self:Log("INFO", "RETURN_OPTION", "Retorno do Anti-Fling=" .. tostring(enabled) .. " | distancia=" .. Core.Config.FarDistance .. " studs | somente neste modo")
        return true
    end
    function self:Patch(obj, key, value)
        local ok, current = pcall(function() return obj[key] end)
        if not ok then self:Failure("READ_" .. key, current); return false end
        if current == value then return true end
        local props = self.Patches[obj]
        if not props or not props[key] then
            if self.PatchCount >= Core.Config.MaxPatches then
                self:Log("WARN", "PATCH_LIMIT", "Limite de propriedades atingido; cobertura parcial.", 10)
                return false
            end
        end
        local wrote, err = pcall(function() obj[key] = value end)
        if not wrote then self:Failure("WRITE_" .. key, path(obj) .. " | " .. tostring(err)); return false end
        if not props then props = {}; self.Patches[obj] = props end
        if not props[key] then props[key] = { old = current, forced = value }; self.PatchCount += 1 end
        props[key].forced = value
        return true
    end
    function self:Restore()
        for obj, props in pairs(self.Patches) do
            for key, entry in pairs(props) do
                local ok, err = pcall(function()
                    if obj[key] == entry.forced then obj[key] = entry.old end
                end)
                if not ok then self:Failure("RESTORE_" .. key, err) end
            end
        end
        self.Patches = {}; self.PatchCount = 0
        if self.Humanoid then
            for state, old in pairs(self.States) do
                local ok, err = pcall(function()
                    if not self.Humanoid:GetStateEnabled(state) then self.Humanoid:SetStateEnabled(state, old) end
                end)
                if not ok then self:Failure("RESTORE_STATE", err) end
            end
        end
        self.States = {}
        for _, entry in ipairs(self.Shields) do
            local ok, err = pcall(function() entry.constraint:Destroy() end)
            if not ok then self:Failure("RESTORE_SHIELD", err) end
        end
        self.Shields = {}
        self.ShieldStats = nil; self.LastShieldSignature = nil
        if self.ShieldFolder then
            local ok, err = pcall(function() self.ShieldFolder:Destroy() end)
            if not ok then self:Failure("RESTORE_SHIELD_FOLDER", err) end
            self.ShieldFolder = nil
        end
    end
    function self:ResetCharacter(character, humanoid, root)
        self:Restore()
        self.Character = character; self.Humanoid = humanoid; self.Root = root
        self.Safe = nil; self.StableSince = nil; self.Previous = nil; self.Pending = nil
        self:ClearReturnTracking()
        self:ClearImpact()
        self.Parts = {}; self.Nodes = {}; self.NextScan = 0; self.WasPaused = false
        self.LastRecovery = -math.huge
        self:Log("INFO", "CHARACTER", "Identidade atualizada; amostras e restauracao separadas por personagem.")
    end
    function self:Context()
        local char = deps.Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root and not root:IsA("BasePart") then root = nil end
        if char ~= self.Character or hum ~= self.Humanoid or root ~= self.Root then self:ResetCharacter(char, hum, root) end
        local reason
        if deps.Clock() < self.SuspendedUntil then reason = "Pausado temporariamente"
        elseif not char or not char.Parent or not hum or not root or not root.Parent then reason = "Aguardando personagem"
        elseif hum.Health <= 0 then reason = "Aguardando respawn"
        elseif hum.Sit or hum.SeatPart then reason = "Pausado: sentado / veiculo"
        elseif root.Anchored then reason = "Pausado: personagem ancorado"
        elseif char:GetAttribute("3FProtectionSuspend") == true then reason = "Pausado por outro movimento"
        end
        if reason then
            if not self.WasPaused then
                self:Restore(); self.Safe = nil; self.StableSince = nil; self.Previous = nil; self.Pending = nil
                self:ClearReturnTracking()
                self:ClearImpact()
                self:Log("INFO", "PAUSE", reason)
            end
            self.WasPaused = true; self:StatusChanged(reason); return false
        end
        if self.WasPaused then self.WasPaused = false; self.NextScan = 0; self:Log("INFO", "RESUME", "Protecao retomada.") end
        self:StatusChanged(self.Mode == "AntiFling" and ("Anti-Fling | retorno " .. (self.FarReturnEnabled and "ligado" or "desligado")) or (names[self.Mode] .. " ativo | F9: detalhes"))
        return true
    end
    function self:BodyPart(obj)
        if not obj or not obj:IsA("BasePart") or not self.Character or not obj:IsDescendantOf(self.Character) then return false end
        local parent = obj.Parent
        while parent and parent ~= self.Character do
            if parent:IsA("Tool") or parent:IsA("Accessory") then return false end
            parent = parent.Parent
        end
        return parent == self.Character
    end
    function self:ScanBody()
        self.Nodes = {}; self.Parts = {}
        local queue = {}; local at = 1; local limited = false; local seen = {}
        local function enqueue(obj)
            if seen[obj] then return end
            -- UI, sons, particulas e nossos escudos nao competem com o corpo pelo limite.
            if not (obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Folder") or obj:IsA("Attachment") or
                obj:IsA("JointInstance") or obj:IsA("WeldConstraint") or obj:IsA("Constraint") or obj:IsA("BodyMover")) then return end
            if #queue >= Core.Config.MaxNodes then limited = true; return end
            seen[obj] = true; table.insert(queue, obj)
        end
        if self.Root then enqueue(self.Root) end
        local children = self.Character:GetChildren()
        for _, child in ipairs(children) do if child:IsA("BasePart") then enqueue(child) end end
        for _, child in ipairs(children) do enqueue(child) end
        while at <= #queue do
            local obj = queue[at]; at += 1
            table.insert(self.Nodes, obj)
            if self:BodyPart(obj) then
                if #self.Parts < Core.Config.MaxParts then table.insert(self.Parts, obj)
                else self:Log("WARN", "BODY_PART_LIMIT", "Mais de 32 partes corporais; cobertura parcial.", 10) end
            end
            if obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Folder") or obj:IsA("Attachment") then
                for _, child in ipairs(obj:GetChildren()) do enqueue(child) end
            end
        end
        if limited then self:Log("WARN", "SCAN_LIMIT", "Corpo com muitos objetos: busca limitada a 256 objetos; cobertura parcial.", 10) end
        -- Purga registros de objetos removidos para nao acumular referencias entre scans.
        for obj, props in pairs(self.Patches) do
            if not obj.Parent then
                for key, entry in pairs(props) do
                    local ok, err = pcall(function() if obj[key] == entry.forced then obj[key] = entry.old end end)
                    if not ok then self:Failure("DETACHED_RESTORE", err) end
                    self.PatchCount -= 1
                end
                self.Patches[obj] = nil
            end
        end
    end
    function self:Ends(joint)
        if joint:IsA("JointInstance") or joint:IsA("WeldConstraint") then return joint.Part0, joint.Part1 end
        if joint:IsA("Constraint") then
            local a, b = joint.Attachment0, joint.Attachment1
            return a and a.Parent, b and b.Parent
        end
        return nil, nil
    end
    function self:SafeToolJoint(joint, a, b)
        for _, obj in ipairs({ joint, a, b }) do
            local parent = obj
            for _ = 1, 32 do
                if not parent then break end
                if parent:IsA("Tool") or parent:IsA("Accessory") then return true end
                if parent == self.Character then break end
                parent = parent.Parent
            end
        end
        return false
    end
    function self:ThrowLinks()
        local seen = {}; local count = 0
        local function inspect(joint)
            if not joint.Parent then return end
            if not joint:IsA("JointInstance") and not joint:IsA("WeldConstraint") and not joint:IsA("Constraint") then return end
            if seen[joint] then return end
            seen[joint] = true; count += 1
            if count > Core.Config.MaxJoints then return end
            if joint:IsA("NoCollisionConstraint") or joint:IsA("AnimationConstraint") then return end
            local a, b = self:Ends(joint)
            if not a or not b or not a:IsA("BasePart") or not b:IsA("BasePart") then return end
            local aBody, bBody = self:BodyPart(a), self:BodyPart(b)
            if aBody == bBody or self:SafeToolJoint(joint, a, b) then return end
            local outside = aBody and b or a
            if outside:IsDescendantOf(self.Character) then return end
            if joint.Enabled == true and self:Patch(joint, "Enabled", false) then
                self.Counters.actions += 1
                self:Log("INFO", "EXTERNAL_LINK", "Ligacao externa desativada localmente: " .. path(joint) .. " | destino=" .. path(outside), 0.8)
            end
        end
        for _, obj in ipairs(self.Nodes) do inspect(obj) end
        for _, part in ipairs(self.Parts) do
            if count > Core.Config.MaxJoints then break end
            local ok, joints = pcall(function() return part:GetJoints() end)
            if ok then
                for _, joint in ipairs(joints) do
                    if count > Core.Config.MaxJoints then break end
                    inspect(joint)
                end
            else self:Failure("JOINTS_READ", joints) end
        end
        if count > Core.Config.MaxJoints then self:Log("WARN", "JOINT_LIMIT", "Muitas ligacoes; cobertura parcial neste scan.", 10) end
    end
    function self:Ragdoll()
        local humanoid = self.Humanoid
        for _, state in ipairs({ HS.FallingDown, HS.Ragdoll }) do
            local ok, err = pcall(function()
                local current = humanoid:GetStateEnabled(state)
                if self.States[state] == nil then self.States[state] = current end
                if current then humanoid:SetStateEnabled(state, false) end
            end)
            if not ok then self:Failure("STATE_BLOCK", err) end
        end
        local pairsByPart = {}
        for _, obj in ipairs(self.Nodes) do
            if obj:IsA("Motor6D") then
                local a, b = self:Ends(obj)
                if self:BodyPart(a) and self:BodyPart(b) then
                    pairsByPart[a] = pairsByPart[a] or {}; pairsByPart[a][b] = true
                    if obj.Enabled == false and self:Patch(obj, "Enabled", true) then
                        self.Counters.actions += 1; self:Log("INFO", "MOTOR", "Motor6D reativado: " .. path(obj), 1)
                    end
                end
            elseif obj:IsA("AnimationConstraint") then
                local a, b = self:Ends(obj)
                if self:BodyPart(a) and self:BodyPart(b) and obj.IsKinematic == false then
                    if self:Patch(obj, "IsKinematic", true) then
                        self.Counters.actions += 1; self:Log("INFO", "AJU", "AnimationConstraint em modo cinematico: " .. path(obj), 1)
                    end
                end
            end
        end
        -- Apenas constraints do mesmo par de um Motor6D interno; nao remove objetos.
        for _, obj in ipairs(self.Nodes) do
            if obj:IsA("BallSocketConstraint") or obj:IsA("HingeConstraint") then
                local a, b = self:Ends(obj)
                if a and b and ((pairsByPart[a] and pairsByPart[a][b]) or (pairsByPart[b] and pairsByPart[b][a])) then
                    self:Patch(obj, "Enabled", false)
                end
            end
        end
    end
    function self:ShieldsScan()
        local wanted = {}; local count = 0; local localParts = {}
        for _, part in ipairs(self.Parts) do
            if part.Parent and part.CanCollide then table.insert(localParts, part) end
        end
        for _, part in ipairs(self.Parts) do
            if part.Parent and not table.find(localParts, part) then table.insert(localParts, part) end
        end
        local candidates = {}
        for _, player in ipairs(deps.Players:GetPlayers()) do
            if player ~= deps.Player then
                local char = player.Character; local root = char and char:FindFirstChild("HumanoidRootPart")
                if root and root:IsA("BasePart") and vectorOK(root.Position) then
                    local dist = (root.Position - self.Root.Position).Magnitude
                    local vel, spin = root.AssemblyLinearVelocity, root.AssemblyAngularVelocity
                    local fast = vectorOK(vel) and vectorOK(spin) and (vel.Magnitude > 100 or spin.Magnitude > 40)
                    if char ~= self.Character and (dist <= Core.Config.ShieldRadius or (fast and dist <= Core.Config.FastShieldRadius)) then
                        table.insert(candidates, { char = char, distance = dist, fast = fast, near = dist <= Core.Config.ShieldRadius })
                    end
                end
            end
        end
        table.sort(candidates, function(a, b) if a.near ~= b.near then return a.near end if a.fast ~= b.fast then return a.fast end return a.distance < b.distance end)
        local profiles = {}; local requested = 0; local longest = 0
        for i = 1, math.min(8, #candidates) do
            local others = {}; local char = candidates[i].char
            for _, other in ipairs(char:GetChildren()) do
                if other:IsA("BasePart") and #others < 32 then table.insert(others, other) end
            end
            for _, item in ipairs(char:GetChildren()) do
                if (item:IsA("Tool") or item:IsA("Accessory")) and #others < 32 then
                    local handle = item:FindFirstChild("Handle")
                    if handle and handle:IsA("BasePart") and handle.CanCollide then table.insert(others, handle) end
                end
            end
            local pairs = #localParts * #others
            table.insert(profiles, { parts = others, pairs = pairs })
            requested += pairs; longest = math.max(longest, pairs)
        end
        -- Distribui o limite entre candidatos: o primeiro nao consome todos os pares.
        for index = 1, longest do
            for _, profile in ipairs(profiles) do
                if index <= profile.pairs then
                    local mine = localParts[(index - 1) % #localParts + 1]
                    local other = profile.parts[math.floor((index - 1) / #localParts) + 1]
                    wanted[mine] = wanted[mine] or {}; wanted[mine][other] = true; count += 1
                    if count >= Core.Config.MaxShields then break end
                end
            end
            if count >= Core.Config.MaxShields then break end
        end
        local kept = {}
        for _, entry in ipairs(self.Shields) do
            local row = wanted[entry.a]
            if row and row[entry.b] and entry.constraint.Parent then
                entry.constraint.Enabled = true
                row[entry.b] = nil; table.insert(kept, entry)
            else entry.constraint:Destroy() end
        end
        self.Shields = kept
        for mine, row in pairs(wanted) do
            for other in pairs(row) do
                local shield
                local ok, err = pcall(function()
                    shield = deps.NewInstance("NoCollisionConstraint")
                    shield.Name = "3F_LocalShield"; shield.Part0 = mine; shield.Part1 = other
                    if not self.ShieldFolder or not self.ShieldFolder.Parent then
                        self.ShieldFolder = deps.NewInstance("Folder")
                        self.ShieldFolder.Name = "3F_LocalShields_V4"; self.ShieldFolder.Parent = deps.Workspace
                    end
                    shield.Parent = self.ShieldFolder
                end)
                if ok then table.insert(self.Shields, { a = mine, b = other, constraint = shield })
                else
                    if shield then pcall(function() shield:Destroy() end) end
                    if self.ShieldFolder and not self.ShieldFolder.Parent then
                        pcall(function() self.ShieldFolder:Destroy() end); self.ShieldFolder = nil
                    end
                    self:Failure("SHIELD_CREATE", err)
                end
            end
        end
        local omitted = math.max(0, requested - #self.Shields)
        self.ShieldStats = { locals = #localParts, candidates = #candidates, pairs = #self.Shields, requested = requested, omitted = omitted, unselected = math.max(0, #candidates - #profiles) }
        local signature = #localParts .. ":" .. #candidates .. ":" .. #self.Shields .. ":" .. requested
        if signature ~= self.LastShieldSignature then
            self.LastShieldSignature = signature
            self:Log("INFO", "SHIELD_STATUS", string.format("partes_locais=%d/%d | candidatos=%d | pares=%d | solicitados=%d | omitidos=%d | corpo_nos=%d", #localParts, #self.Parts, #candidates, #self.Shields, requested, omitted, #self.Nodes), 2)
        end
        if requested > count then self:Log("WARN", "SHIELD_LIMIT", "Cobertura parcial: limite de 512 pares distribuido entre ate oito candidatos.", 10) end
        if #self.Shields < count then self:Log("WARN", "SHIELD_INCOMPLETE", "Cobertura parcial: pares selecionados nao puderam ser criados; veja SHIELD_CREATE.", 10) end
    end
    function self:Ground(cf)
        local params = deps.NewRaycastParams()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { self.Character }
        params.RespectCanCollide = true
        local hit = deps.Workspace:Raycast(cf.Position + Vector3.new(0, 1, 0), Vector3.new(0, -9, 0), params)
        if not hit or hit.Normal.Y < 0.6 then return false end
        return hit.Instance:IsA("Terrain") or (hit.Instance:IsA("BasePart") and hit.Instance.Anchored)
    end
    function self:Abnormal(vel, ang)
        if not vectorOK(vel) or not vectorOK(ang) then return true, "NON_FINITE" end
        local horizontal = Vector3.new(vel.X, 0, vel.Z).Magnitude
        if self.Mode == "AntiThrow" then
            if horizontal > 115 or vel.Y > 125 or ang.Magnitude > 65 then return true, "THROW_SPEED" end
            local previous = self.Previous
            if previous then
                local elapsed = deps.Clock() - previous.at
                local delta = Vector3.new(vel.X - previous.vel.X, 0, vel.Z - previous.vel.Z).Magnitude
                if elapsed > 0 and elapsed < 0.10 and horizontal > 70 and delta > 65 then return true, "THROW_BURST" end
            end
        elseif self.Mode == "AntiFling" then
            if vel.Y > self:UpLimit() then return true, "FLING_UP" end
            if horizontal > 180 or ang.Magnitude > 65 then return true, "FLING_SPEED" end
        end
        return false, nil
    end
    function self:UpLimit()
        local hum = self.Humanoid
        local jump = hum and hum.JumpPower or 50
        if hum and hum.UseJumpPower == false then
            jump = math.sqrt(2 * math.max(0, deps.Workspace.Gravity or 196.2) * math.max(0, hum.JumpHeight or 7.2))
        end
        if not finite(jump) then jump = 50 end
        return math.min(500, math.max(110, jump * 1.6 + 15))
    end
    function self:ReportDrivers()
        local classes = { BodyVelocity=true, BodyPosition=true, BodyForce=true, BodyAngularVelocity=true, BodyGyro=true,
            BodyThrust=true, LinearVelocity=true, VectorForce=true, LineForce=true, AngularVelocity=true, AlignPosition=true, AlignOrientation=true }
        local found = {}; local total = 0
        for _, obj in ipairs(self.Nodes) do
            if obj.Parent and classes[obj.ClassName] then
                total += 1
                if #found < 5 then table.insert(found, obj.ClassName .. ":" .. bound(path(obj), 100)) end
            end
        end
        self:Log("INFO", "PHYSICS_DRIVERS", "Controladores presentes no Character amostrado=" .. total .. " | " .. table.concat(found, " | ") .. " | presenca nao prova causa; servidor e objetos externos nao cobertos")
    end
    function self:FlingGuard(phase)
        if self.Mode ~= "AntiFling" then return end
        local root = self.Root; local vel, ang = root.AssemblyLinearVelocity, root.AssemblyAngularVelocity
        local bad, reason = self:Abnormal(vel, ang)
        if not cframeOK(root.CFrame) then bad = true; reason = "INVALID_CFRAME" end
        local now = deps.Clock()
        if bad then
            self.ImpactUntil = now + Core.Config.ImpactWindow; self.LastFlingHitAt = now
            if phase == "PreSimulation" then self.Counters.preGuards += 1 else self.Counters.postGuards += 1 end
            self:Recover(vel, reason .. "/" .. phase)
        elseif now < self.ImpactUntil then
            local horizontal = Vector3.new(vel.X, 0, vel.Z)
            local walk = self.Humanoid.WalkSpeed or 16
            if not finite(walk) then walk = 16 end
            local limit = math.max(24, math.min(48, walk + 12))
            local changed = vel.Y > 0 or horizontal.Magnitude > limit or ang.Magnitude > 12
            if horizontal.Magnitude > limit then horizontal = horizontal.Unit * limit end
            if changed then
                root.AssemblyLinearVelocity = Vector3.new(horizontal.X, math.min(0, vel.Y), horizontal.Z)
                root.AssemblyAngularVelocity = V0
                self.Counters.dampings += 1
                self:Log("INFO", "IMPACT_DAMPING", "Contencao curta apos impacto real: subida cortada, queda e deslocamento limitado preservados.", 1)
            end
            -- Trata subida acumulada mesmo quando o pico ja foi cortado antes da leitura.
            local safe = self.Safe
            if self.FarReturnEnabled and safe and safe.root == root and now - safe.at <= Core.Config.SafeAge and
                now - self.LastPositionRecovery >= Core.Config.PositionCooldown then
                local delta = root.Position - safe.cf.Position
                if (delta.Y >= 12 or Vector3.new(delta.X, 0, delta.Z).Magnitude >= 24) and delta.Magnitude <= Core.Config.SafeDistance and self:Ground(safe.cf) then
                    root.CFrame = safe.cf + Vector3.new(0, 0.25, 0); self.LastPositionRecovery = now
                    self.MotionSample = { position = root.Position, at = now, root = root }
                    self.Counters.actions += 1
                    self:Log("INFO", "IMPACT_POSITION", "Subida/deslocamento apos impacto; retorno curto solicitado.", 1)
                end
            end
        end
    end
    function self:ObserveReturn(vel, ang)
        local pending = self.ReturnPending
        if not pending or deps.Clock() - pending.at < 0.18 then return end
        self.ReturnPending = nil
        if pending.root ~= self.Root or pending.mode ~= self.Mode then return end
        local position = self.Root.Position
        local distance = vectorOK(position) and (position - pending.target).Magnitude or math.huge
        local bad = self:Abnormal(vel, ang)
        local repeated = self.LastFlingHitAt > pending.at + 0.001 and deps.Clock() - self.LastFlingHitAt < 0.20
        bad = bad or repeated
