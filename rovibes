if not(title and title.Parent and gradient and gradient.Parent)then return end
local t=TN(now)or TK()
title.Text=LUXY_TITLE
title.TextColor3=LUXY_PRIMARY
title.Rotation=0
subtitle.Text=LUXY_SUBTITLE
subtitle.TextColor3=LUXY_SECONDARY
