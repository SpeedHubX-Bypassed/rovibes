  rate=math.min(PERF.remoteAuraRate*distanceScale,PERF.remoteTotalRate/share),
  live=PERF.remoteLiveParticles/share,
  burst=math.max(1,math.floor(PERF.remoteBurstBudget*distanceScale*math.sqrt(crowdScale))),
