end
local function fontMeasureKey(record,text,size)
    return (record and record.family or "fallback")..(record and record.assignmentFallback and ":enumFallback" or "").."\0"..(record and record.weightName or "Regular")..
        "\0"..(record and record.styleName or "Normal").."\0"..tostring(size).."\0"..text
