local function fontMetricsInfo(name,text,size)
    -- Consulta somente; não cria objetos, não abre fila e não inicia chamadas de medição.
    text=tostring(text or "")
    size=math.clamp(tonumber(size) or 24,1,100)
    local record=fontRecord(name)
    local entry=fontMeasureCache[fontMeasureKey(record,text,size)]
    if not entry then
        return "Medida desta configuração ainda não solicitada; largura específica não confirmada. | estado=NOT_REQUESTED"
    end
    local pixels=string.format("%.2f px",entry.width)
    if entry.measurement=="FONT_FACE_GET_TEXT_BOUNDS_ASYNC" and entry.resolved then
        return "Largura da fonte escolhida confirmada por GetTextBoundsAsync: "..pixels..". | estado=FONT_FACE_CONFIRMED"
    end
    if record and record.isExtended then
        local reason=record.assignmentFallback and "FONT_FACE_ASSIGNMENT_REFUSED" or entry.failed
        if not record.face then reason="FONT_FACE_UNAVAILABLE" end
        if reason then
            return "Largura alternativa "..pixels.."; medida da fonte escolhida não confirmada. | estado=FONT_FACE_FALLBACK | motivo="..reason..
                " | base="..tostring(entry.measurement)
        end
        if not entry.resolved then
            local stage=entry.queued and "PENDING" or "WAITING_QUEUE_SLOT"
            return "Largura provisória "..pixels.."; aguardando a medida da fonte escolhida. | estado=FONT_FACE_"..stage..
                " | base="..tostring(entry.measurement)
        end
    end
    if entry.baseConfirmed then
        return "Largura medida por GetTextSize com Enum.Font: "..pixels..". | estado=ENUM_CONFIRMED"
    end
    return "Largura estimada "..pixels.."; GetTextSize indisponível. | estado=WIDTH_ESTIMATED | motivo=GET_TEXT_SIZE_UNAVAILABLE"
end



