function LB.updateDetailPosition()
	if not detail.Visible or not S.SelectedPlayer then return end
	local row=S.Rows[S.SelectedPlayer.UserId]
	if not row or not row.Root or not row.Root.Parent or not row.Root.Visible then
		detail.Visible = false
		return
	end
	local rowTop=row.Root.AbsolutePosition.Y
	local rowBottom=rowTop + row.Root.AbsoluteSize.Y
	local listTop=list.AbsolutePosition.Y
	local listBottom=listTop + list.AbsoluteSize.Y
	if rowBottom < listTop or rowTop > listBottom then
		detail.Visible = false
		return
	end
	local panelLeft=panel.AbsolutePosition.X
	local rowCenter=rowTop + row.Root.AbsoluteSize.Y * .5
	local menuHeight=detail.AbsoluteSize.Y > 0 and detail.AbsoluteSize.Y or 350
	local viewportY=(workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize.Y) or 720
	local y=rowCenter - 72
	y=math.max(8, math.min(y, viewportY - menuHeight - 8))
	local popupWidth=detail.AbsoluteSize.X > 0 and detail.AbsoluteSize.X or 264
	if panelLeft - popupWidth - 12 >= 8 then
		detail.AnchorPoint = Vector2.new(1,0)
		detail.Position = UDim2.fromOffset(panelLeft - 12, y)
		detailArrow.Position = UDim2.new(1,5,0,math.max(18, math.min(menuHeight - 18, rowCenter - y)))
	else
		detail.AnchorPoint = Vector2.new(0,0)
		detail.Position = UDim2.fromOffset(panel.AbsolutePosition.X + panel.AbsoluteSize.X + 12, y)
		detailArrow.Position = UDim2.new(0,-5,0,math.max(18, math.min(menuHeight - 18, rowCenter - y)))
	end
end
