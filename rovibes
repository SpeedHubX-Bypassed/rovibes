local function animateTagIcon(view,t)
    local animation=view.iconAnimation
    if not animation then return end
    t=tonumber(t) or 0
    if t~=t or t==math.huge or t==-math.huge then t=0 end
    if not State.animation then
        if not animation.paused then
            if animation.gradient then
                animation.gradient.Offset=V2(0,0)
                animation.gradient.Rotation=25
            end
            if animation.border then
                if animation.borderMode=="IMAGE" then
                    animation.border.ImageTransparency=.04
                else
                    animation.border.Transparency=.04
                end
            end
        end
        animation.paused=true
        if view.mastery then view.mastery.root.Visible=false end
        State.masteryStart=nil
        return
    end
    animation.paused=false
    if animation.gradient then animation.gradient.Offset=V2(((t*.3)%1)*2-1,0) end
    if animation.border then
        local pulse=.04+.08*(.5+.5*math.sin(t*2))
        if animation.borderMode=="IMAGE" then
            animation.border.ImageTransparency=pulse
        else
            animation.border.Transparency=pulse
        end
    end
    local emote=view.mastery
    if not emote then return end
    local age=State.masteryStart and t-State.masteryStart or -1
    if age<0 or age>=State.MasteryDuration then emote.root.Visible=false;return end
    emote.root.Visible=true
    -- MASTERY_ASSET_FIX_2: a arte publicada é autoritativa. Enquanto o download
    -- ainda estiver pendente, mostramos o ImageLabel (ele aparece assim que chegar)
    -- em vez de cair prematuramente na maestria geométrica criada localmente.
    if emote.lastTriggerSerial~=(State.masteryTriggerSerial or 0) then
        emote.lastTriggerSerial=State.masteryTriggerSerial or 0
        local loaded,failed=State.masteryAssetState(emote)
        emote.usingAsset=not failed
        emote.fallback.Visible=failed
        emote.image.Visible=not failed
        -- Mantém o reflexo armado mesmo se o asset ainda estiver carregando no primeiro frame.
        -- O próprio ImageLabel passa a desenhar assim que a imagem chega, sem perder o sweep desta execução.
        emote.imageSheen.Visible=not failed
        emote.numeral.Position=not failed and U2(.5,0,0,emote.asset.romanY) or U2(.5,0,.5,-3)
        emote.numeral.TextSize=not failed and emote.asset.textSize or (emote.tier==3 and 26 or 24)
    end
    local tier=emote.tier
    local enter=math.clamp(age/(tier==3 and .65 or tier==2 and .48 or .38),0,1)
    local leave=math.clamp((age-3.20)/.80,0,1)
    local ease=1-(1-enter)^3
    local retract=leave*leave*(3-2*leave)
    local travel=ease*(1-retract)
    local pulse=tier==3 and .065*math.sin(enter*math.pi)*math.exp(-enter*1.2) or .025*math.sin(enter*math.pi)
    local size=(.08+.92*ease+pulse)*(1-.97*retract)
    emote.scale.Scale=emote.unit*size
    -- Sobe do ícone e retorna ao mesmo ponto; distância física não cresce com o tamanho da fonte.
    emote.root.Position=U2(0,emote.originX,0,emote.originY-(tier==3 and 22 or tier==2 and 16 or 12)*emote.unit*travel)
    local alpha=math.clamp(age/.16,0,1)*(1-retract)
    if emote.lastAlpha~=alpha then
        for _,item in ipairs(emote.fades) do item.object[item.key]=1-(1-item.base)*alpha end
        emote.lastAlpha=alpha
    end
    for _,wing in ipairs(emote.wings) do
        local unfold=tier==3 and 1-(1-math.clamp((age-.14-wing.row*.045)/.46,0,1))^3 or ease
        local spread=unfold*(1-retract)
        wing.object.Position=U2(.5,wing.x*(.22+.78*spread),.5,wing.y+7*(1-spread))
        wing.object.Rotation=wing.rotation*(.2+.8*spread)
    end
    if emote.usingAsset then
        local tilt=tier==3 and -3*(1-ease)*(1-retract)+2.2*retract or 0
        emote.image.Rotation=tilt;emote.imageSheen.Rotation=tilt;emote.numeral.Rotation=tilt
    else emote.numeral.Rotation=0 end
    if tier==3 then
        local textGlow=(1-math.cos(age*(2*math.pi/1.8)))*.5
        local textColor=emote.textBaseColor:Lerp(emote.textGlowColor,textGlow)
        emote.numeral.TextColor3=textColor;emote.loyaltyLabel.TextColor3=textColor
        local crown=1-(1-math.clamp((age-.42)/.4,0,1))^3
        for _,part in ipairs(emote.crown) do
            part.object.Position=U2(.5,part.x*(.45+.55*crown)*(1-.4*retract),0,part.y-8*(1-crown)+12*retract)
            part.object.Rotation=part.rotation*(1-.5*retract)
        end
        for _,facet in ipairs(emote.facets) do
            facet.object.Position=U2(.5,facet.x*(.4+.6*crown)*(1-.5*retract),.5,facet.y-5*(1-crown))
            facet.object.Rotation=facet.rotation*crown*(1-retract)
        end
        emote.seal.Rotation=45-10*(1-crown)+10*retract
        -- Ouro: uma passagem lenta de luz durante quase toda a permanência de 4s.
        local sweep=-1+2*math.clamp((age-.30)/3.05,0,1)
        emote.shine.Offset=V2(sweep,0)
        if emote.usingAsset then
            emote.imageSheen.Visible=true
            emote.imageSheen.ImageTransparency=1-alpha*.60
            emote.image.ImageTransparency=math.max(0,1-alpha*.98)
        end
    else
        emote.shine.Offset=V2(-1+2*math.clamp((age-.4)/.75,0,1),0)
        if emote.usingAsset then
            emote.imageSheen.ImageTransparency=math.max(0,1-alpha*.72)
        end
    end
    emote.assetShine.Offset=emote.shine.Offset
end
