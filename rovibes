function State.emitMasteryRequest(tier)
    if BRIDGE and type(BRIDGE.RequestMastery)=="function" then
        local ok=pcall(BRIDGE.RequestMastery,tier)
        if ok then return true end
    end
    if RUNTIME_BOOTSTRAP and type(RUNTIME_BOOTSTRAP.OnMasteryRequest)=="function" then
        local ok=pcall(RUNTIME_BOOTSTRAP.OnMasteryRequest,tier)
