local function getTagGraphemes(text)
    local out={}
    local ok=pcall(function()
        for first,last in utf8.graphemes(text) do out[#out+1]=text:sub(first,last) end
    end)
    if ok then return out,"NATIVE_GRAPHEMES" end
    table.clear(out)
    local joinNext=false
    local regionalCount=0
    -- Alternativa conservadora para runtimes sem utf8.graphemes; não é uma implementação Unicode completa.
    pcall(function()
        for _,code in utf8.codes(text) do
            local part=utf8.char(code)
            local mark=(code>=0x0300 and code<=0x036F) or (code>=0x1AB0 and code<=0x1AFF)
                or (code>=0x1DC0 and code<=0x1DFF) or (code>=0x20D0 and code<=0x20FF)
                or (code>=0xFE00 and code<=0xFE0F) or (code>=0xFE20 and code<=0xFE2F)
                or (code>=0x1F3FB and code<=0x1F3FF) or (code>=0xE0100 and code<=0xE01EF)
            local regional=code>=0x1F1E6 and code<=0x1F1FF
            local attach=mark or joinNext or code==0x200D or (regional and regionalCount%2==1)
            if attach and #out>0 then out[#out]..=part else out[#out+1]=part end
            joinNext=code==0x200D
            regionalCount=regional and regionalCount+1 or 0
        end
    end)
    if #out==0 and text~="" then out[1]=text end
    return out,"FALLBACK_COMMON_CLUSTERS"
end
