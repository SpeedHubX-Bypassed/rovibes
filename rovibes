local rankingCountFxSerial=0
function LB.rankingSubtitleMarkup(count,visibleCount,countFlash)
	count=tonumber(count)or 0
	visibleCount=tonumber(visibleCount)or count
	local pt=(App and LOW(TS(App.CurrentLanguage or"en"))=="ptbr")
	local playersWord=pt and"JOGADORES"or"PLAYERS"
	local foundWord=pt and"ENCONTRADOS"or"FOUND"
	local searchExtra=S.SearchText~=""and("  /  "..tostring(visibleCount).." "..foundWord)or""
	if IS_MUSHYO then
		local countRGB=countFlash=="leave"and"176,184,194"or"232,236,242"
		local extra=searchExtra~=""and('<font color="rgb(164,174,191)">'..searchExtra..'</font>')or""
		return '<font size="11" color="rgb(224,54,58)">MUSH</font><font size="11" color="rgb(245,248,255)">YO</font><font color="rgb(110,121,140)">  •  </font><font size="8" color="rgb('..countRGB..')">'..tostring(count)..' '..playersWord..'</font>'..extra
	end
	local extra=searchExtra~=""and('<font color="rgb(164,174,191)">'..searchExtra..'</font>')or""
	return '<font color="rgb(245,248,255)">'..tostring(count)..' '..playersWord..'</font>'..extra
end
function LB.updateRankingSubtitle(count,visibleCount,animateChange)
	count=tonumber(count)or 0
	visibleCount=tonumber(visibleCount)or count
	local old=S.DisplayedPlayerCount
	if old==nil then
		S.DisplayedPlayerCount=count
		rankingSubtitle.Text=LB.rankingSubtitleMarkup(count,visibleCount)
		return
	end
	local delta=count-old
	S.DisplayedPlayerCount=count
	if not animateChange or delta==0 then
		rankingSubtitle.Text=LB.rankingSubtitleMarkup(count,visibleCount)
		return
	end
	rankingCountFxSerial+=1
	local serial=rankingCountFxSerial
	local leaving=delta<0
	rankingSubtitle.Text=LB.rankingSubtitleMarkup(count,visibleCount,leaving and"leave"or"join")
	rankingSubtitle.Position=UDim2.new(.5,0,0,leaving and 18 or 23)
	rankingSubtitleScale.Scale=.94
	LB.tween(rankingSubtitle,.18,{Position=UDim2.new(.5,0,0,20)})
	LB.tween(rankingSubtitleScale,.18,{Scale=1.08})
	task.delay(.18,function()
		if not S.Alive or serial~=rankingCountFxSerial then return end
		LB.tween(rankingSubtitleScale,.18,{Scale=1})
	end)
	rankingDeltaWrap.Visible=true
	rankingDeltaArrow.Text=leaving and"↘"or"↗"
	rankingDeltaArrow.TextColor3=IS_MUSHYO and C.SOFT or C.RED
	rankingDeltaArrow.Rotation=0
	rankingDeltaArrow.TextTransparency=0
	rankingDeltaText.Text=(delta>0 and"+"or"")..tostring(delta)
	rankingDeltaText.TextColor3=leaving and C.SOFT or(IS_MUSHYO and C.WHITE or C.GREEN)
	rankingDeltaText.TextTransparency=0
	LB.tween(rankingDeltaArrow,.42,{Rotation=leaving and-360 or 360})
	task.delay(.72,function()
		if not S.Alive or serial~=rankingCountFxSerial then return end
		LB.tween(rankingDeltaArrow,.16,{TextTransparency=1})
		LB.tween(rankingDeltaText,.16,{TextTransparency=1})
		rankingSubtitle.Text=LB.rankingSubtitleMarkup(count,visibleCount)
		task.delay(.17,function()
			if serial==rankingCountFxSerial and rankingDeltaWrap then
				rankingDeltaWrap.Visible=false
				rankingDeltaArrow.Rotation=0
				rankingDeltaArrow.TextTransparency=0
				rankingDeltaText.TextTransparency=0
			end
		end)
	end)
end
