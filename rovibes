local function luxyEnsureStroke(label,name,color,thickness)
if not label then return nil end
local stroke=label:FindFirstChild(name)
if not(stroke and stroke:IsA("UIStroke"))then
stroke=I0("UIStroke")
stroke.Name=name
stroke.Parent=label
end
stroke.Color=color
stroke.Thickness=thickness
stroke.Transparency=0
PC(function()stroke.LineJoinMode=Enum.LineJoinMode.Round end)
return stroke
end

