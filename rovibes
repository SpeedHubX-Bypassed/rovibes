 local function handleTouch(touchPositions,processed)
  if processed or not State.alive or not State.assetReady or State.target==1 or not State.core or not State.core.Parent then return end
  local camera=workspace.CurrentCamera
  if not camera then return end
  local center,onScreen=camera:WorldToViewportPoint(State.core.Position)
  if not onScreen or center.Z<=0 then return end
  local axis=math.max(State.core.Size.X,State.core.Size.Y,State.core.Size.Z)
  local edge=camera:WorldToViewportPoint(State.core.Position+camera.CFrame.RightVector*(axis*.72))
  local radius=math.clamp((Vector2.new(edge.X,edge.Y)-Vector2.new(center.X,center.Y)).Magnitude,64,150)
  for _,point in ipairs(touchPositions or{})do
   local p=typeof(point)=="Vector2"and point or Vector2.new(point.X,point.Y)
   if (p-Vector2.new(center.X,center.Y)).Magnitude<=radius then
    requestOpen(LP)
    return
   end
  end
 end
