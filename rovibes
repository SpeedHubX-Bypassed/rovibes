function LB.captureNativeNameBadges(root)
	if not root or not root.Parent or S.CapturedBadgeRoots[root]then return end
	S.CapturedBadgeRoots[root]=true
	local map={}
	for _,p in ipairs(Players:GetPlayers())do
		map[LB.normalize(p.Name)]=p
		map[LB.normalize(p.DisplayName)]=map[LB.normalize(p.DisplayName)]or p
	end
	for _,label in ipairs(root:GetDescendants())do
		if label:IsA("TextLabel")or label:IsA("TextButton")then
			local p=map[LB.normalize(label.Text)]
			if p and not S.NameBadgeCache[p.UserId]then
				local scope=label.Parent
				for _=1,2 do
					if not scope or scope==root.Parent then break end
					for _,im in ipairs(scope:GetDescendants())do
						if(im:IsA("ImageLabel")or im:IsA("ImageButton"))and im.Image~=""then
							local sz=im.AbsoluteSize
							local n=LB.normalize(im.Name)
							local small=(sz.X>=6 and sz.Y>=6 and sz.X<=28 and sz.Y<=28)
							local hinted=string.find(n,"premium",1,true)or string.find(n,"plus",1,true)or string.find(n,"verified",1,true)or string.find(n,"badge",1,true)
							local near=false
							pcall(function()
								local lx=label.AbsolutePosition.X+label.AbsoluteSize.X
								local ix=im.AbsolutePosition.X
								near=ix>=lx-6 and ix<=lx+34 and math.abs(im.AbsolutePosition.Y-label.AbsolutePosition.Y)<=18
							end)
							if hinted or(small and near)then
								S.NameBadgeCache[p.UserId]={Image=im.Image,ImageColor3=im.ImageColor3,ImageRectOffset=im.ImageRectOffset,ImageRectSize=im.ImageRectSize}
								break
							end
						end
					end
					if S.NameBadgeCache[p.UserId]then break end
					scope=scope.Parent
				end
			end
		end
	end
end
function LB.scanCustomLeaderboard()
	if not S.Alive then return end
	for _,d in ipairs(PlayerGui:GetDescendants()) do
		if S.Gui and d:IsDescendantOf(S.Gui) then
			continue
		end
		if (d:IsA("TextLabel") or d:IsA("TextButton"))
			and LB.normalize(d.Text) == CFG.GameHeaderA
		then
			local node=d.Parent
			local candidate=nil
			for _ = 1, 8 do
				if not node or node == PlayerGui then break end
				if node:IsA("GuiObject")
					and LB.hasExactText(node, CFG.GameHeaderB)
				then
					candidate=node
					local size=node.AbsoluteSize
					if size.X >= 220 and size.Y >= 120 then
						break
					end
				end
				node=node.Parent
			end
			if candidate then
				S.HasCustomLeaderboard=true
				LB.captureNativeNameBadges(candidate)
				LB.suppressObject(candidate)
			end
		end
	end
end
